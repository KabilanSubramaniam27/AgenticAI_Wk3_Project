LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIMENSION=4096
EMBEDDING_BATCH_SIZE=32
ACTIAN_VECTORAI_URL=localhost:6574
ACTIAN_VECTORAI_REST_URL=http://localhost:6573
ACTIAN_VECTORAI_COLLECTION=seniorcare_knowledge
ACTIAN_VECTORAI_ACCESS_TOKEN=
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=4
SCRAPER_USER_AGENT=SeniorCareResearchBot/0.1 (+contact: configure-in-env)
CHUNK_TARGET_TOKENS=900
CHUNK_OVERLAP_TOKENS=120
MIN_CHUNK_TOKENS=50
MIN_CHUNK_CHARACTERS=200
DEFAULT_COUNTRY=US
DEFAULT_STATE=Virginia
SUPPORTED_COUNTIES=Richmond City,Henrico County,Chesterfield County,Hanover County
VECTOR_CATEGORIES=healthcare_access,transportation,medication_reference,discharge_support,food_meals,benefits_financial,home_support,caregiver_support,social_wellbeing
SIMULATION_MODE=true
ALLOW_EXTERNAL_MUTATIONS=false
REQUIRE_APPROVAL_FOR_WRITES=true
MCP_SERVER_URL=http://127.0.0.1:8001/mcp
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8001
MCP_SERVER_PATH=/mcp
MCP_READ_MAX_ATTEMPTS=3
MCP_READ_RETRY_BASE_SECONDS=0.25
SESSION_TTL_MINUTES=1440
APPLICATION_LOG_PATH=application.log
APPLICATION_LOG_MAX_FIELDS=12
APPLICATION_LOG_MAX_STRING=160
RAG_BM25_TOP_K=20
RAG_VECTOR_TOP_K=20
RAG_FUSION_TOP_K=15
RAG_FINAL_TOP_K=6
RRF_K=60
ENABLE_RERANKER=true
RERANKER_PROVIDER=local
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
SAVE_EMBEDDINGS_DEBUG=false
